    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://dist.memurai.com/releases/Memurai-Developer/4.1.8/MemuraiDeveloperFiles/Memurai-Developer-EULA.rtf</licenseUrl>
